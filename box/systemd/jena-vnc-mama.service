[Unit]
Description=Jena desktop full-control VNC for mama's takeover (localhost only; reached only through a one-time token on her desktop agent)
After=jena-xvfb.service
PartOf=jena-xvfb.service
StartLimitIntervalSec=0
[Service]
User=user
ExecStartPre=/bin/sleep 1
ExecStart=/usr/bin/x11vnc -display :99 -forever -shared -nopw -localhost -rfbport 5901 -noxdamage -quiet -defer 5 -wait 5
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
