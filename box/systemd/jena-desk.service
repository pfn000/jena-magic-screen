[Unit]
Description=Jena desktop agent (her hands + eyes + door on 127.0.0.1:6081), runs as her own user
After=jena-wm.service jena-gateway.service
PartOf=jena-xvfb.service
StartLimitIntervalSec=0
[Service]
User=jena
Environment=DISPLAY=:99 HOME=/home/jena JENA_BOX_PORT=6081 PYTHONUNBUFFERED=1
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/python3 -u /home/jena/.jena_desk.py
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
