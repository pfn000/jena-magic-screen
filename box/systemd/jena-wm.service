[Unit]
Description=Jena desktop: window manager + wallpaper
After=jena-xvfb.service
PartOf=jena-xvfb.service
StartLimitIntervalSec=0
[Service]
User=jena
Environment=DISPLAY=:99 HOME=/home/jena
ExecStartPre=/bin/sleep 1
ExecStart=/bin/sh -c '[ -x /home/jena/.fehbg ] && /home/jena/.fehbg; exec openbox'
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
