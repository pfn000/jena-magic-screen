{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/jena?route=:path*"
    }
  ],
  "functions": {
    "api/jena.js": {
      "maxDuration": 30
    }
  }
}