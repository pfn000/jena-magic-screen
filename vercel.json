{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/tab-live",
      "destination": "/tab-live.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/jena?route=:path*"
    }
  ],
  "functions": {
    "api/jena.js": {
      "maxDuration": 30
    }
  },
  "git": {
    "deploymentEnabled": {
      "box-state": false,
      "jena-memory": false
    }
  }
}
