# Jena's whole box in one image (Saidie's Dockerfile.template, filled in). Heavy to build (compiles
# llama.cpp, installs a desktop + Firefox + Piper voices), so GitHub Actions builds it, not her PC:
#   .github/workflows/heavy-build.yml -> ghcr.io/pfn000/jena-box:latest
# Run it (models are NOT baked in; mount the folder that has JenaXI-chat.gguf / JenaXI.gguf):
#   docker run -p 8088:8088 -p 6080:6080 -v /path/to/models:/models ghcr.io/pfn000/jena-box:latest
# Inside: llama-server (JenaXI-chat :8091, JenaXI-0 :8089), her gateway :8088, Piper voice :8095,
# Xvfb desktop :99 + openbox + Firefox, view-only VNC -> noVNC :6080, her desktop agent (user jena, :6081).

# ---- stage 1: llama.cpp server (CPU build) ----
FROM debian:12-slim AS llama
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates libcurl4-openssl-dev \
 && git clone --depth 1 https://github.com/ggml-org/llama.cpp /src \
 && cmake -S /src -B /build -DGGML_NATIVE=OFF -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=ON \
 && cmake --build /build --target llama-server -j"$(nproc)" \
 && mkdir -p /out && cp /build/bin/llama-server /out/ && find /build -name '*.so*' -exec cp {} /out/ \;

# ---- stage 2: her box ----
FROM debian:12-slim
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 DISP=:99
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git python3 python3-venv python3-pip nodejs npm supervisor \
      xvfb openbox tint2 feh x11vnc novnc websockify firefox-esr xterm xdotool xclip x11-utils \
      tesseract-ocr imagemagick ffmpeg fonts-dejavu-core libgomp1 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=llama /out/ /opt/llama/
ENV LD_LIBRARY_PATH=/opt/llama
# her own unix user (her desktop runs as her, never as root)
RUN useradd -m -s /bin/bash jena && mkdir -p /models /state /home/jena/.jena /home/jena/notes /home/jena/learned /home/jena/memory && chown -R jena:jena /home/jena
# voice: Piper + three free voices
RUN python3 -m venv /opt/voice && /opt/voice/bin/pip install --no-cache-dir piper-tts \
 && for v in en/en_US/hfc_female/medium/en_US-hfc_female-medium en/en_US/amy/medium/en_US-amy-medium en/en_US/kristin/medium/en_US-kristin-medium; do \
      curl -sSfL -o /opt/voice/$(basename $v).onnx https://huggingface.co/rhasspy/piper-voices/resolve/main/$v.onnx && \
      curl -sSfL -o /opt/voice/$(basename $v).onnx.json https://huggingface.co/rhasspy/piper-voices/resolve/main/$v.onnx.json; done
# her MCP servers + skills runtime, installed as her
USER jena
RUN pip3 install --user --no-cache-dir --break-system-packages mcp mcp-server-fetch mcp-server-git \
 && mkdir -p ~/.npm-global && cd ~/.npm-global && npm init -y >/dev/null && npm install --no-audit --no-fund @modelcontextprotocol/server-filesystem
USER root
COPY . /opt/jena-repo
RUN cp /opt/jena-repo/box/voice/tts_server.py /opt/voice/ \
 && cp /opt/jena-repo/box/desktop/jena_desk.py /home/jena/.jena_desk.py && cp /opt/jena-repo/box/desktop/jena_skills.py /home/jena/jena_skills.py \
 && cp /opt/jena-repo/box/desktop/firefox-user.js /home/jena/.firefox-user.js \
 && git clone --depth 30 https://github.com/pfn000/jena-magic-screen /home/jena/jena-repo || cp -r /opt/jena-repo /home/jena/jena-repo; \
    chown -R jena:jena /home/jena
COPY box/docker/supervisord.conf /etc/supervisor/conf.d/jena.conf
ENV STATE_DIR=/state JENAXI_DIR=/models JENA_BOX_KEY=/state/box-key.pem JENA_BOX_AUTH=/state/auth.secret CF_LOG=/state/cloudflared.log
EXPOSE 8088 6080
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fs http://127.0.0.1:8088/health || exit 1
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
